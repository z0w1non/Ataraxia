{
  "schemas": {
    "agent_core_input": {
      "type": "object",
      "required": ["goal", "context", "constraints", "cycle", "latest_stage", "results", "workspace_files", "workspace_media", "available_roles", "user_output_language", "internal_language"],
      "properties": {
        "goal": {"type": "string"},
        "context": {"type": "string"},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "cycle": {"type": "integer"},
        "latest_stage": {"type": "string"},
        "results": {"type": "object"},
        "workspace_files": {"type": "array", "items": {"type": "object"}},
        "workspace_media": {"type": "array", "items": {"type": "object"}},
        "available_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {"id": {"type": "string"}, "purpose": {"type": "string"}},
            "required": ["id", "purpose"],
            "additionalProperties": false
          }
        },
        "user_output_language": {"type": "string"},
        "internal_language": {"type": "string"}
      },
      "additionalProperties": false
    },
    "agent_core_output": {
      "type": "object",
      "required": ["workflow"],
      "properties": {
        "workflow": {
          "type": "object",
          "required": ["initial_stage", "stages"],
          "properties": {
            "initial_stage": {"type": "string"},
            "stages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "properties": {
                  "id": {"type": "string"},
                  "role_id": {"type": "string"},
                  "result_key": {"type": "string"},
                  "next_stages": {"type": "array", "minItems": 1, "items": {"type": "string"}}
                },
                "required": ["id", "role_id", "result_key", "next_stages"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agent_compressor_input": {
      "type": "object",
