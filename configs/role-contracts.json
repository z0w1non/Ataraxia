                }
              }
            },
            "required": [
              "command_id",
              "arguments"
            ],
            "additionalProperties": false
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "blocked",
            "partial"
          ]
        }
      },
      "required": [
        "result",
        "file_changes",
        "commands",
        "status"
