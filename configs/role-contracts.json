  "generic_agent": {
    "roles": [
      {
        "id": "core",
        "system_prompt": "agent_core",
        "purpose": "Design a task-specific workflow by selecting and ordering available specialist roles based on the user's goal and workspace.",
        "input_schema_ref": "agent_core_input",
        "output_schema_ref": "agent_core_output",
        "message_structure": {"roles": ["system", "user"]}
      },
      {
        "id": "planner",
        "system_prompt": "agent_planner",
        "purpose": "Translate the task goal, constraints, workspace evidence, and prior results into ordered actions and measurable success criteria; do not design workflow stages or choose roles.",
        "input_schema_ref": "agent_planner_input",
        "output_schema_ref": "agent_planner_output",
        "message_structure": {
          "roles": [
            "system",
            "user"
          ]
        }
      },
      {
        "id": "executor",
        "system_prompt": "agent_executor",
        "purpose": "Implement approved work through validated file diffs and allowlisted commands.",
        "input_schema_ref": "agent_executor_input",
        "output_schema_ref": "agent_executor_output",
        "message_structure": {
          "roles": [
            "system",
            "user"
          ]
        }
      },
      {
        "id": "reviewer",
        "system_prompt": "agent_reviewer",
        "purpose": "Inspect changed workspace files and command results against the completion criteria.",
        "input_schema_ref": "agent_reviewer_input",
        "output_schema_ref": "agent_reviewer_output",
        "message_structure": {
          "roles": [
            "system",
            "user"
          ]
        }
      },
      {
        "id": "improver",
        "system_prompt": "agent_improver",
        "purpose": "Address review findings and prepare the next execution cycle.",
        "input_schema_ref": "agent_improver_input",
        "output_schema_ref": "agent_improver_output",
        "message_structure": {
          "roles": [
            "system",
            "user"
          ]
        }
      },
      {
        "id": "router",
        "system_prompt": "agent_router",
        "purpose": "Choose the next eligible workflow stage from current evidence and completion criteria.",
        "input_schema_ref": "agent_router_input",
        "output_schema_ref": "agent_router_output",
        "message_structure": {
          "roles": [
            "system",
            "user"
          ]
        }
      },
      {
        "id": "researcher",
        "system_prompt": "agent_researcher",
        "purpose": "Inspect the assigned workspace and gather traceable evidence relevant to the task.",
        "input_schema_ref": "agent_researcher_input",
        "output_schema_ref": "agent_researcher_output",
        "message_structure": {
          "roles": [
            "system",
            "user"
          ]
        }
      },
      {
        "id": "verifier",
        "system_prompt": "agent_verifier",
        "purpose": "Verify requested outcomes against explicit criteria and available evidence.",
        "input_schema_ref": "agent_verifier_input",
        "output_schema_ref": "agent_verifier_output",
        "message_structure": {
          "roles": [
            "system",
            "user"
          ]
        }
      },
      {
        "id": "security_reviewer",
        "system_prompt": "agent_security_reviewer",
        "purpose": "Review proposed changes for concrete security and data-boundary risks.",
        "input_schema_ref": "agent_security_reviewer_input",
        "output_schema_ref": "agent_security_reviewer_output",
        "message_structure": {
          "roles": [
            "system",
            "user"
          ]
        }
      },
      {
        "id": "impact_reviewer",
        "system_prompt": "agent_impact_reviewer",
        "purpose": "Assess likely compatibility, data, dependency, and user-visible effects of a proposed task before implementation, and suggest proportionate mitigations.",
        "input_schema_ref": "agent_impact_reviewer_input",
        "output_schema_ref": "agent_impact_reviewer_output",
        "message_structure": {"roles": ["system", "user"]}
      },
      {
        "id": "context_compressor",
        "system_prompt": "context_compressor",
        "purpose": "Compress accumulated task context while preserving decisions, constraints, evidence, open items, and the latest phase result.",
